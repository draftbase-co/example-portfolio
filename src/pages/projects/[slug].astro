---
import { toHtml } from "@draftbase/renderer";
import Base from "../../layouts/Base.astro";
import { getAll, url, type Profile, type Project } from "../../lib/draftbase";

export async function getStaticPaths() {
	const [projects, [profile]] = await Promise.all([
		getAll<Project>("project"),
		getAll<Profile>("profile"),
	]);
	return projects.map((project) => ({
		params: { slug: project.fields.slug },
		props: { project, profile },
	}));
}

const { project, profile } = Astro.props;
const body = await toHtml(project.fields.body ?? "");
const name = profile?.fields.name ?? "Portfolio";
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const schema = [
	{
		"@context": "https://schema.org",
		"@type": "CreativeWork",
		name: project.fields.title,
		description: project.fields.summary,
		url: canonical,
		image: project.fields.cover?.url ?? undefined,
		dateCreated: project.fields.year ? String(project.fields.year) : undefined,
		author: { "@type": "Person", name },
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{
				"@type": "ListItem",
				position: 1,
				name: "Work",
				item: new URL(url(), Astro.site).href,
			},
			{ "@type": "ListItem", position: 2, name: project.fields.title, item: canonical },
		],
	},
];
---

<Base
	title={project.fields.title}
	description={project.fields.summary}
	image={project.fields.cover?.url}
	ogType="article"
	name={name}
	schema={schema}
>
	<article class="article">
		<a class="muted" href={`${url()}#work`} style="font-size:var(--text-sm)">← All work</a>
		<h1 style="font-size:var(--text-4xl);margin:12px 0 8px">{project.fields.title}</h1>
		<p class="muted">
			{project.fields.year}
			{
				project.fields.liveUrl && (
					<>
						{" · "}
						<a href={project.fields.liveUrl} rel="noopener noreferrer">
							Visit site
						</a>
					</>
				)
			}
		</p>
		{
			project.fields.cover?.url && (
				<img
					src={project.fields.cover.url}
					alt={project.fields.cover.altText ?? project.fields.title}
					style="margin:24px 0"
				/>
			)
		}
		<div class="db-content" set:html={body} />
	</article>
</Base>
